# Local development default: SQLite, so the app runs without extra setup.
# For production or Supabase later, override with your real Postgres connection string.
DATABASE_URL=sqlite:///./notes_rag.db
JWT_SECRET=dev-secret-change-me
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Supabase example later:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
